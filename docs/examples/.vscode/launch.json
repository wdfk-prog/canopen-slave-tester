{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CANopen Master - Remote GDB Debug",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/canopen-master/build/canopen_master",
            "args": [],
            "stopAtEntry": false,

            "cwd": "${workspaceFolder}/canopen-master",
            "environment": [],
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerServerAddress": "172.168.1.130:9091",
            "miDebuggerPath": "/opt/fsl-imx-xwayland/6.1-mickledore/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
            "targetArchitecture": "arm64",

            "symbolLoadInfo": {
                "loadAll": true
            },

            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pending breakpoints",
                    "text": "set breakpoint pending on",
                    "ignoreFailures": false
                },
                {
                    "description": "Set Yocto target sysroot",
                    "text": "set sysroot /opt/fsl-imx-xwayland/6.1-mickledore/sysroots/armv8a-poky-linux",
                    "ignoreFailures": false
                },
                {
                    "description": "Set shared library fallback search path",
                    "text": "set solib-search-path /opt/fsl-imx-xwayland/6.1-mickledore/sysroots/armv8a-poky-linux/usr/local/lib",
                    "ignoreFailures": false
                },
                {
                    "description": "Automatically load shared library symbols",
                    "text": "set auto-solib-add on",
                    "ignoreFailures": false
                },
                {
                    "description": "Keep debugger interrupt inside GDB",
                    "text": "handle SIGINT stop print nopass",
                    "ignoreFailures": false
                },
                {
                    "description": "Pass SIGTERM to application",
                    "text": "handle SIGTERM nostop noprint pass",
                    "ignoreFailures": false
                },
                {
                    "description": "Pass Lely I/O wake-up signal",
                    "text": "handle SIGUSR1 nostop noprint pass",
                    "ignoreFailures": false
                },
                {
                    "description": "Disable pagination",
                    "text": "set pagination off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable remote range stepping",
                    "text": "set range-stepping off",
                    "ignoreFailures": true
                }
            ],

            "postRemoteConnectCommands": [
                {
                    "description": "Install automatic Lely symbol loader",
                    "text": "source /home/embedsky/share/lely-imx8p/.vscode/load-lely-symbols.gdb",
                    "ignoreFailures": false
                },
                {
                    "description": "Install system-library stepping filters",
                    "text": "source /home/embedsky/share/lely-imx8p/.vscode/skip-system-libs.gdb",
                    "ignoreFailures": false
                }
            ],

            "sourceFileMap": {
                "/home/embedsky/share/lely-imx8p/canopen-master": "${workspaceFolder}/canopen-master",
                "/home/embedsky/share/lely-imx8p/lely-core": "${workspaceFolder}/lely-core"
            },

            "logging": {
                "engineLogging": false,
                "trace": false,
                "traceResponse": false,
                "programOutput": true,
                "exceptions": true,
                "moduleLoad": false
            }
        }
    ]
}
